{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "strictPropertyInitialization": false,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "bun"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules/**"
    ]
}